{
  "name": "silverlink-wechat-miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:weapp": "npm exec --package=node@20 -- node ./node_modules/@tarojs/cli/bin/taro build --type weapp --watch",
    "build:weapp": "npm exec --package=node@20 -- node ./node_modules/@tarojs/cli/bin/taro build --type weapp",
    "typecheck": "tsc --noEmit",
    "ci:upload": "node ./scripts/wechat-ci.mjs upload",
    "ci:preview": "node ./scripts/wechat-ci.mjs preview"
  },
  "dependencies": {
    "@tarojs/components": "^4.0.7",
    "@tarojs/helper": "^4.0.7",
    "@tarojs/react": "^4.0.7",
    "@tarojs/runtime": "^4.0.7",
    "@tarojs/shared": "^4.0.7",
    "@tarojs/taro": "^4.0.7",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@tarojs/cli": "^4.0.7",
    "@tarojs/plugin-framework-react": "^4.0.7",
    "@tarojs/plugin-platform-weapp": "^4.0.7",
    "@tarojs/vite-runner": "^4.0.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "miniprogram-ci": "^2.1.31",
    "typescript": "^5.8.0",
    "vite": "^4.5.14"
  }
}
