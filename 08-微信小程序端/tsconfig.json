{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared-i18n/*": ["../shared/i18n/*"],
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"]
    },
    "types": ["@tarojs/taro", "node"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["config", "src"],
  "exclude": ["dist", "node_modules"]
}
