<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 基础配置 -->
        <TextView style="@style/RelaySectionTitle" android:text="@string/basic_config_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>

        <com.google.android.material.card.MaterialCardView
            style="@style/RelayCardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutDeviceName"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enrollment_device_name">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputDeviceName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutReceiverPhone"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/config_receiver_phone">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputReceiverPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutServerUrl"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/config_server_url">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputServerUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutDeviceId"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/config_device_id">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputDeviceId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutDeviceSecret"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/config_device_secret">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputDeviceSecret"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutPrefixRule"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/config_prefix_rule">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputPrefixRule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/textEnrollmentStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/enrollment_not_applied"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetEnrollment"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/enrollment_reset" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyEnrollment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/enrollment_apply" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefreshEnrollment"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/enrollment_refresh" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRequestPermissions"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/request_sms_permission" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUnifiedKeepAlive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/request_unified_keepalive" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRootForceProtection"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/request_root_force_protection" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSyncConfig"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/sync_remote_config" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 运行状态 -->
        <TextView style="@style/RelaySectionTitle" android:text="@string/runtime_status_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>

        <com.google.android.material.card.MaterialCardView
            style="@style/RelayCardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <include layout="@layout/item_config_row" android:id="@+id/rowDeviceStatus" />
                <include layout="@layout/item_config_row" android:id="@+id/rowServiceStatus" />
                <include layout="@layout/item_config_row" android:id="@+id/rowPermissionStatus" />
                <include layout="@layout/item_config_row" android:id="@+id/rowBatteryOptimization" />
                <include layout="@layout/item_config_row" android:id="@+id/rowExactAlarm" />
                <include layout="@layout/item_config_row" android:id="@+id/rowProtectionSummary" />
                <include layout="@layout/item_config_row" android:id="@+id/rowNonRootProtection" />
                <include layout="@layout/item_config_row" android:id="@+id/rowMediaKeepAlive" />
                <include layout="@layout/item_config_row" android:id="@+id/rowRootProtection" />
                <include layout="@layout/item_config_row" android:id="@+id/rowLastHeartbeat" />
                <include layout="@layout/item_config_row" android:id="@+id/rowLastSync" />
                <include layout="@layout/item_config_row" android:id="@+id/rowVersion" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
