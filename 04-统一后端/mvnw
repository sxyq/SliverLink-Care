#!/bin/sh
# Maven Wrapper for Unix
MAVEN_PROJECTBASEDIR="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
LOCAL_MAVEN_BIN="$MAVEN_PROJECTBASEDIR/.tools/apache-maven-3.9.6/bin/mvn"
LOCAL_SETTINGS="$MAVEN_PROJECTBASEDIR/.mvn/settings.xml"

if [ -x "$LOCAL_MAVEN_BIN" ]; then
    if [ -f "$LOCAL_SETTINGS" ]; then
        exec "$LOCAL_MAVEN_BIN" -s "$LOCAL_SETTINGS" "$@"
    fi
    exec "$LOCAL_MAVEN_BIN" "$@"
fi

if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Downloading Maven Wrapper..."
    curl -sL -o "$WRAPPER_JAR" "https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper.jar"
fi

exec java \
  -Dmaven.multiModuleProjectDirectory="$MAVEN_PROJECTBASEDIR" \
  -classpath "$WRAPPER_JAR" \
  org.apache.maven.wrapper.MavenWrapperMain \
  "$@"
